# Public (safe for the browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
# Server-only (never prefix with NEXT_PUBLIC_, never commit). Needed from Stage 3 (admin)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: read-only GitHub token (no scopes) only if GitHub rate-limits the automatic repo import
GITHUB_TOKEN=
